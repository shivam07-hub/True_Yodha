NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=https://your-railway-url.railway.app
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# Cloudflare Turnstile site key for the pre-login anon CV endpoints.
# Unset → falls back to Cloudflare's always-pass TEST key (dev-safe). On prod,
# set the REAL site key in lockstep with the backend TURNSTILE_SECRET (paired,
# like the Razorpay keys) or anon requests fail verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
