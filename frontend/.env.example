# Browser-safe values only. NEXT_PUBLIC_* is bundled into the browser.
# A production build refuses to start when critical values are absent,
# placeholders are present, or service URLs do not use HTTPS.
# The Supabase anon key is safe here only because every exposed table/storage
# object is protected by RLS and the service-role key stays server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=https://your-backend.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-public-key-id
# Required on the Production deployment. Preview uses Cloudflare's documented
# test key unless a Preview-specific site key is configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Required on Production for canonical public-profile share links. Preview
# deployments fall back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_SEEKERS_COUNT=

# Server-only Next.js values used by server components/routes. API_INTERNAL_URL
# is optional and falls back to the public API URL. Do not rename these with
# NEXT_PUBLIC_ and do not put credentials in them.
API_INTERNAL_URL=https://your-backend.example.com
