{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run validate:env",
    "start": "next start",
    "validate:env": "node scripts/validate-runtime-env.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs && TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test tests/*.test.tsx",
    "check:ui-drift": "node scripts/ui-drift-guard.mjs",
    "test:contracts": "node --test tests/api-session-contract.test.mjs",
    "test:onboarding": "node --test tests/onboarding-contract.test.mjs",
    "test:market-browse": "tsx --test tests/market-browse-contract.test.ts",
    "test:beta-feedback": "node --no-warnings --test tests/beta-feedback-contract.test.mjs",
    "test:upskilling": "node --test tests/upskilling-load-state.test.mjs",
    "test:taxonomy": "tsx --test tests/taxonomy-engine.test.ts",
    "test:seo": "tsx --test tests/seo-sitemap-robots.test.ts",
    "new:issue": "tsx ../scripts/new-issue.ts",
    "newsletter:sync": "tsx ../scripts/sync-newsletter.ts",
    "newsletter:check": "tsx ../scripts/check-newsletter-sync.ts",
    "newsletter:feed": "tsx ../scripts/newsletter-feed.ts",
    "seo:indexnow": "tsx ../scripts/indexnow-ping.ts",
    "growth:import-tracker": "tsx ../scripts/import-growth-tracker.ts",
    "linkedin:lint": "tsx ../scripts/linkedin-publish-due.ts --check-only",
    "linkedin:publish-due": "tsx ../scripts/linkedin-publish-due.ts",
    "linkedin:publish-due:live": "tsx ../scripts/linkedin-publish-due.ts --execute",
    "prebuild": "npm run validate:env && npm run newsletter:check && npm run newsletter:feed",
    "dev:clean": "rm -rf .next && next dev",
    "qa:mobile": "../.venv/bin/python ../scripts/qa-mobile-capture.py",
    "test:cv-fidelity": "TSX_TSCONFIG_PATH=tsconfig.test.json tsx --test tests/cv-artifact-fidelity.test.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.102.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "1.7.0",
    "next": "14.2.35",
    "next-mdx-remote": "^6.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-loading-skeleton": "^3.5.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.2",
    "tailwind-merge": "^3.5.0",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
