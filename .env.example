MYRO_SMOKE_PASSWORD=your-smoke-password
MYRO_EXPECTED_VERSION=
PLAYBOOK_CHUNKS_PATH=
NEWSLETTER_SOURCE_DIR=Myro Newsletter

# ── Frontend/browser-safe values ───────────────────────────────────────────
# Only the anon key and public identifiers belong in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=https://your-backend.example.com
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-public-key-id
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_SEEKERS_COUNT=
API_INTERNAL_URL=https://your-backend.example.com

