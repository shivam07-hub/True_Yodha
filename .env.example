JOB_SWITCH_REVIEWER_EMAIL=your-reviewer@example.com
JOB_SWITCH_ADMIN_TOKEN=your-job-switch-admin-token
MYRO_ANALYTICS_REFRESH_SECRET=your-analytics-refresh-secret
MYRO_GROWTH_ACCESS_TOKEN=your-growth-access-token
RAZORPAY_KEY_ID=your-razorpay-public-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
REDIS_URL=redis://localhost:6379/0
JOB_COMPUTE_QUEUE_NAME=jobs_compute
JOB_COMPUTE_STATUS_TTL_SECONDS=86400
JOB_COMPUTE_LOCK_TTL_SECONDS=1800
SYNC_THREADPOOL_TOKENS=100
JOB_VERIFY_LIMIT=200
JOB_VERIFY_CONCURRENCY=10
JOB_VERIFY_PER_HOST=4
JOB_VERIFY_STALE_DAYS=7
JOB_VERIFY_PRIORITY_STALE_HOURS=24
RAILWAY_ENVIRONMENT=development
DEBUG=false
RAILWAY_GIT_COMMIT_SHA=
ALLOWED_ORIGINS=http://localhost:3000
LLM_MAX_CONCURRENCY=8
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_SECONDS=20
LLM_REQUEST_TIMEOUT_SECONDS=45
RESEND_FROM_EMAIL=Myro <noreply@himyro.com>
CV_UPLOAD_SUPPORT_EMAIL=support@himyro.com
CV_UPLOAD_FALLBACK_FORM_URL=
CV_UPLOAD_ALERT_WINDOW_MINUTES=15
CV_UPLOAD_ALERT_MIN_SAMPLES=25
