{
  "name": "titan-email-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP server for Titan Email over IMAP and SMTP",
  "type": "module",
  "bin": {
    "titan-email-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.16",
    "nodemailer": "^9.0.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
