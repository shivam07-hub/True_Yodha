# Use an app password when two-factor authentication is enabled.
TITAN_EMAIL=you@yourdomain.com
TITAN_APP_PASSWORD=replace-with-an-app-password

# Default US-hosted Titan endpoints. Change only for a provider-specific setup.
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465

# Sending is disabled unless this value is exactly true.
TITAN_ALLOW_SEND=false
