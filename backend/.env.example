SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# LM Studio — local models (no rate limits, priority 0)
# Get exact identifiers from LM Studio → Server tab → "Model" dropdown
LM_STUDIO_TAGGER_MODEL=    # instruction model for skill tagging  — used by skill_tagger.py
LM_STUDIO_RANKER_MODEL=    # reasoning model for job ranking      — used by llm_ranker.py
LM_STUDIO_EXTRACTOR_MODEL= # model for JD field extraction        — used by jd_enricher.py (defaults to TAGGER_MODEL if empty)
LM_STUDIO_BASE_URL=        # Optional: override port (default: http://localhost:1234/v1)

# Cloud LLM fallback chain — add any/all; missing keys are skipped automatically
# Fallback order: LM Studio → Gemini → Cerebras → Groq → SambaNova → OpenRouter
GEMINI_API_KEY=          # aistudio.google.com — 500 req/day free
CEREBRAS_API_KEY=        # cloud.cerebras.ai  — 14,400 req/day free
GROQ_API_KEY=            # console.groq.com   — 14,400 req/day free
SAMBANOVA_API_KEY=       # cloud.sambanova.ai — 1,000 req/day free
OPENROUTER_API_KEY=      # openrouter.ai      — 50 req/day free

# Job re-ranking (Phase 1F)
OPENAI_API_KEY=

# Email — Resend
# Magic-link / signup confirm still route through Supabase SMTP. This key is
# read by app.services.email_service for custom transactional sends — currently
# the Myrology astrologer booking notification. Best-effort: a missing key logs
# a warning and never blocks the booking write.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Myro <noreply@himyro.com>

# Myrology — booking requests are emailed here for manual confirm by the astrologer
MYROLOGY_ASTROLOGER_EMAIL=

# Institutions (B2B beta) — placement-cell beta applications are emailed here for
# manual sales follow-up. Empty = persist-only (no notification sent).
INSTITUTIONS_LEAD_EMAIL=

# Razorpay checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudflare Turnstile secret for the pre-login anon CV endpoints. Unset → the
# backend skips verify (dev-safe, rate-limit-only). Once set, verification is
# fail-closed: a missing/invalid token is a 403. Pair with the frontend
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (same Turnstile widget) when flipping prod.
TURNSTILE_SECRET=

# Deployment
RAILWAY_ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]

# Async job compute (Redis + RQ worker)
REDIS_URL=redis://localhost:6379/0
JOB_COMPUTE_QUEUE_NAME=jobs_compute
JOB_COMPUTE_STATUS_TTL_SECONDS=86400
JOB_COMPUTE_LOCK_TTL_SECONDS=1800
