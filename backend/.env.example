# Server-only secrets. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWKS_URL=
# Optional early-stage anti-bot layer. Per-IP limits remain active while false.
# When true, a missing/invalid secret disables only the protected anonymous
# routes; it never blocks API startup.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=your-turnstile-secret

# Local LLM model identifiers and endpoint.
LM_STUDIO_TAGGER_MODEL=
LM_STUDIO_RANKER_MODEL=
LM_STUDIO_EXTRACTOR_MODEL=
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Server-side provider credentials. Missing keys are skipped by the fallback chain.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
GROQ_API_KEY=your-groq-api-key
SAMBANOVA_API_KEY=your-sambanova-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email providers and recipients.
SENDGRID_API_KEY=your-sendgrid-api-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Myro <noreply@himyro.com>
MYROLOGY_ASTROLOGER_EMAIL=your-astrologer@example.com
INSTITUTIONS_LEAD_EMAIL=your-institutions-contact@example.com
CV_UPLOAD_SUPPORT_EMAIL=support@himyro.com
CV_UPLOAD_FALLBACK_FORM_URL=

# Internal and webhook credentials. Keep empty until the corresponding integration is provisioned.
NEWSLETTER_DISTRIBUTION_ADMIN_TOKEN=your-newsletter-admin-token
SCRAPE_WEBHOOK_TOKEN=your-scrape-webhook-token
MYROLOGY_ADMIN_TOKEN=your-myrology-admin-token
JOB_SWITCH_REVIEWER_EMAIL=your-reviewer@example.com
JOB_SWITCH_ADMIN_TOKEN=your-job-switch-admin-token
MYRO_ANALYTICS_REFRESH_SECRET=your-analytics-refresh-secret
MYRO_GROWTH_ACCESS_TOKEN=your-growth-access-token

# Razorpay: KEY_ID is used server-side to create orders; only the public ID is also
# copied to the frontend as NEXT_PUBLIC_RAZORPAY_KEY_ID. Secrets remain here.
RAZORPAY_KEY_ID=your-razorpay-public-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Runtime and async jobs. Production startup is fail-closed unless Supabase,
# Redis, Razorpay, an LLM provider, and an exact CORS allowlist are configured.
# DEBUG must remain false.
# The explicit release tier: sandbox | dev | prod. Set it on every deployed
# service; leave it empty on a laptop (that resolves to sandbox). Everything
# below it is inference kept only for services that predate this variable.
MYRO_ENV=
RAILWAY_ENVIRONMENT=development
# Injected by Railway. Myro uses the service name to distinguish the Develop
# backend from production because both share one Railway environment object.
RAILWAY_SERVICE_NAME=
DEBUG=false
# Exact CORS allowlist. This is the WHOLE policy in production.
# Production example:
# ALLOWED_ORIGINS=https://himyro.com,https://www.himyro.com,https://truemirror.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
# The app's own front door — the origin baked into sign-in links we hand to
# third parties (partner SSO). Empty = the first ALLOWED_ORIGINS entry.
APP_BASE_URL=
# Extra preview origins for non-production tiers, as an anchored regex. Vercel
# mints a new origin per preview deployment, so the dev tier cannot be served by
# an exact allowlist alone. Ignored entirely when the tier is prod.
PREVIEW_ORIGIN_REGEX=^https://truemirror-[a-z0-9-]+\.vercel\.app$
REDIS_URL=redis://localhost:6379/0
JOB_COMPUTE_QUEUE_NAME=jobs_compute
JOB_COMPUTE_STATUS_TTL_SECONDS=86400
JOB_COMPUTE_LOCK_TTL_SECONDS=1800
SYNC_THREADPOOL_TOKENS=100
# Process-local bulkhead for concurrent Supabase GET/HEAD requests. This is
# deliberately below the shared database connection ceiling.
SUPABASE_READ_MAX_INFLIGHT=40
SUPABASE_READ_QUEUE_TIMEOUT_SECONDS=0.25
JOB_VERIFY_LIMIT=200
JOB_VERIFY_CONCURRENCY=10
JOB_VERIFY_PER_HOST=4
JOB_VERIFY_STALE_DAYS=7
JOB_VERIFY_PRIORITY_STALE_HOURS=24
# Closure-share guard: when one apply-host produces at least _MIN closures and
# they are at least _SHARE of that host's conclusive verdicts in a single sweep,
# read it as the source breaking, not the jobs closing, and write no closures.
JOB_VERIFY_CLOSE_GUARD_MIN=10
JOB_VERIFY_CLOSE_GUARD_SHARE=0.9
RAILWAY_GIT_COMMIT_SHA=

# Provider limits/timeouts and observability.
LLM_MAX_CONCURRENCY=8
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
LLM_RETRY_MAX_SECONDS=20
LLM_REQUEST_TIMEOUT_SECONDS=45
CV_UPLOAD_ALERT_WINDOW_MINUTES=15
CV_UPLOAD_ALERT_MIN_SAMPLES=25
CV_UPLOAD_ALERT_FAILURE_RATIO=0.25
OPS_ALERT_EMAIL=
# Notice closer (GitHub Action only). The web process does not read these.
RAILWAY_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_REF=
NOTICE_AUTHOR=1
NOTICE_GIT=1
GROWTH_OPS_EMAIL=
VERIFIER_DEAD_MAN_HOURS=2
VERIFIER_HEALTH_INTERVAL_MINUTES=5
VERIFIER_PRIORITY_STALE_HOURS=24

# One-off scripts and production smoke checks.
MYRO_API_BASE_URL=https://api.example.com
MYRO_API_URL=https://api.example.com
MYRO_SMOKE_EMAIL=smoke-user@example.com
MYRO_SMOKE_PASSWORD=your-smoke-password
MYRO_EXPECTED_VERSION=
PLAYBOOK_CHUNKS_PATH=

# Stage B skill judgment against a LOCAL OpenAI-compatible endpoint
# (`skill_judgment_cli --provider local`). Offline batch runs only — this lane
# has no fallback, so a dead endpoint fails the run instead of silently
# escaping to a paid cloud ladder for thousands of jobs. Defaults match the
# LM Studio out-of-the-box settings, so all three are usually unnecessary.
LOCAL_INFERENCE_BASE_URL=http://localhost:1234/v1
LOCAL_INFERENCE_MODEL=google/gemma-3-4b
LOCAL_INFERENCE_API_KEY=lm-studio
# Batch deadline for the local lane. The web-tier 45s times out every call at
# the 1-2 min/job this exists to measure.
LOCAL_INFERENCE_TIMEOUT_SECONDS=300

# Optional alias accepted only by scripts/gen-taxonomy-artifacts.ts.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
