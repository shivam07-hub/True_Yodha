# Gmail credentials
# 2-Step Verification must be ON for the Google account, then generate an
# App Password at https://myaccount.google.com/apppasswords and use that here
# (a normal Gmail password will be rejected by IMAP/SMTP).
MAIL_EMAIL=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Optional overrides (defaults shown — already correct for Gmail)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465

# Outbound safety gate. Sending is DISABLED unless this is exactly "true".
MAIL_ALLOW_SEND=false

# Where mail_download_attachment writes files (default: <tmpdir>/gmail-mcp-attachments)
# MAIL_ATTACHMENT_DIR=/Users/you/Downloads/gmail-attachments
