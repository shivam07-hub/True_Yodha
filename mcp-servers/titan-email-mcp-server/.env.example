# Titan / GoDaddy Professional Email credentials
# If your account has 2FA enabled, generate an app-specific password in
# https://secureserver.titan.email -> Settings -> Security, and use that here.
TITAN_EMAIL=you@yourdomain.com
TITAN_PASSWORD=your-app-password

# Optional overrides (defaults shown)
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465

# Outbound safety gate. Sending is DISABLED unless this is exactly "true".
TITAN_ALLOW_SEND=false

# Where titan_download_attachment writes files (default: <tmpdir>/titan-mcp-attachments)
# TITAN_ATTACHMENT_DIR=/Users/you/Downloads/titan-attachments
