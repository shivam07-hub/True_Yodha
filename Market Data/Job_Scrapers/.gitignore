# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────
venv/
.venv/
env/

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Secrets & Environment ────────────────────────────────────────
.env
backend/.env

# ── Database files ───────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Jupyter ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Selenium / Browser automation ────────────────────────────────
geckodriver.log
chromedriver.log

# ── Output directories (large/regenerated data) ─────────────────
# The master CSV is large but IS tracked (it's core data)
# Per-company raw outputs are NOT tracked (regenerated by scrapers)
*/Outputs/
!Master_Output/

# Match result CSVs (generated per-candidate)
backend/match_results/

# ── Temporary files ──────────────────────────────────────────────
*.tmp
*.temp
*.log
