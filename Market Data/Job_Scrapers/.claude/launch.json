{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jupyter Notebook Server",
      "runtimeExecutable": "jupyter",
      "runtimeArgs": ["notebook", "--notebook-dir=All_Scripts", "--no-browser"],
      "port": 8888
    },
    {
      "name": "Master Orchestrator (Full Pipeline)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["All_Scripts/MASTER_Job_Scraper_Orchestrator_v2.py"],
      "port": 0,
      "autoPort": true
    },
    {
      "name": "Master Orchestrator (Consolidate Only)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["All_Scripts/MASTER_Job_Scraper_Orchestrator_v2.py", "--skip-scrape"],
      "port": 0,
      "autoPort": true
    },
    {
      "name": "Quick Scraper Tests",
      "runtimeExecutable": "python",
      "runtimeArgs": ["All_Scripts/test_scrapers_quick.py"],
      "port": 0,
      "autoPort": true
    },
    {
      "name": "Regenerate All Notebooks",
      "runtimeExecutable": "python",
      "runtimeArgs": ["All_Scripts/create_all_scrapers_v2.py"],
      "port": 0,
      "autoPort": true
    }
  ]
}
